# Copy this file to ".env" and fill in your keys.

PORT=5000

# The address of the React app (comma separate multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# REQUIRED. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for speech-to-text + translation (it must accept audio input).
# If this model name is ever retired, set any current Gemini Flash model here.
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL but recommended for the best Sinhala / Tamil / English voices.
# Enable "Cloud Text-to-Speech API" in Google Cloud and create an API key.
# Leave empty to use the free fallback voice (no pitch control).
GOOGLE_TTS_API_KEY=
